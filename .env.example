# Clave del proveedor de modelo. Solo vive en el backend; nunca en el front, el repositorio ni los logs.
ANTHROPIC_API_KEY=
# Proveedor del adaptador LLM: anthropic | simulado (el simulado no necesita clave; sirve para pruebas)
LLM_PROVEEDOR=anthropic
# Modelo y esfuerzo de razonamiento (low | medium | high | xhigh | max)
LLM_MODELO=claude-opus-5-5
LLM_ESFUERZO=low
# Tiempo máximo de espera al proveedor, en milisegundos
LLM_TIMEOUT_MS=90000
# Topes de costo (PRD §8): iteraciones herramienta→modelo por turno y tokens por sesión
MAX_ITERACIONES=25
MAX_TOKENS_SESION=600000
# Tope global de tokens del motor sumando todas las sesiones (persistido en out/uso.json)
MAX_TOKENS_GLOBAL=3000000
# Límite de turnos por IP y por hora en la API pública
LIMITE_TURNOS_HORA=40
# Puerto HTTP del backend
PORT=3000
# Zona horaria (las reglas de negocio no usan el reloj; solo los timestamps de los logs)
TZ=America/Bogota
# Opcionales: otro buzón para probar casos nuevos y otra carpeta de salida
# BUZON_DIR=fixtures/reto-02/buzon
# OUT_DIR=out
# Pausa por uso fuera de propósito: turnos seguidos sin herramientas desde una IP antes de pausarla (0 la desactiva),
# minutos de la primera pausa (cada reincidencia la triplica) y techo de la pausa en minutos
ENFRIAMIENTO_UMBRAL=6
ENFRIAMIENTO_MINUTOS=5
ENFRIAMIENTO_MAXIMO_MINUTOS=1440
