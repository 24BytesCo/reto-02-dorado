# Variables del backend (PRD §6.5: sin valores). Una línea vacía toma el valor por defecto indicado en su comentario.

# Clave del proveedor de modelo. Solo vive en el backend; nunca en el front, el repositorio ni los logs.
ANTHROPIC_API_KEY=
# Proveedor del adaptador LLM: anthropic | simulado (el simulado no necesita clave; sirve para pruebas).
# Es la única con valor: el adaptador no acepta el proveedor vacío. Por defecto anthropic.
LLM_PROVEEDOR=anthropic
# Modelo (por defecto claude-opus-5-5)
LLM_MODELO=
# Esfuerzo de razonamiento: low | medium | high | xhigh | max (por defecto low)
LLM_ESFUERZO=
# Tiempo máximo de espera al proveedor, en milisegundos (por defecto 90000)
LLM_TIMEOUT_MS=
# Topes de costo (PRD §8): iteraciones herramienta→modelo por turno (por defecto 25) y tokens por sesión (por defecto 600000)
MAX_ITERACIONES=
MAX_TOKENS_SESION=
# Tope global de tokens del motor sumando todas las sesiones, persistido en out/uso.json (por defecto 3000000)
MAX_TOKENS_GLOBAL=
# Límite de turnos por IP y por hora en la API pública (por defecto 40)
LIMITE_TURNOS_HORA=
# Puerto HTTP del backend (por defecto 3000)
PORT=
# Otro buzón para probar casos nuevos (por defecto fixtures/reto-02/buzon) y otra carpeta de salida (por defecto out)
BUZON_DIR=
OUT_DIR=
# Pausa por uso fuera de propósito: turnos seguidos sin herramientas, sin pendientes y sin vocabulario del dominio
# desde una IP antes de pausarla (por defecto 12; 0 si LLM_PROVEEDOR=simulado; 0 la desactiva),
# minutos de la primera pausa, que cada reincidencia triplica (por defecto 5), y techo de la pausa (por defecto 1440)
ENFRIAMIENTO_UMBRAL=
ENFRIAMIENTO_MINUTOS=
ENFRIAMIENTO_MAXIMO_MINUTOS=
# La zona horaria (TZ=America/Bogota) la fija el Dockerfile; no se pone aquí porque TZ vacía significa UTC.
# Las reglas de negocio no usan el reloj: solo los timestamps de los logs.
